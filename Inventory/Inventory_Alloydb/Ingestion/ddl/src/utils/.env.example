# Copy this file to `.env` in the same directory and fill in your own values.
# `.env` is ignored by git; never commit real credentials.
# ---------- AlloyDB ----------
ALLOYDB_INSTANCE_URI=<YOUR_VALUE_HERE>
ALLOYDB_USER=<YOUR_VALUE_HERE>
ALLOYDB_PASS=<YOUR_VALUE_HERE>
ALLOYDB_NAME=<YOUR_VALUE_HERE>
REGION=<YOUR_VALUE_HERE>
ALLOYDB_CLUSTER=<YOUR_VALUE_HERE>
ALLOYDB_INSTANCE=<YOUR_VALUE_HERE>
ALLOYDB_DATABASE=<YOUR_VALUE_HERE>
ALLOYDB_TABLESCHEMA=<YOUR_VALUE_HERE>

# ---------- Service Account Credentials ----------
# GOOGLE_APPLICATION_CREDENTIALS=<YOUR_VALUE_HERE>
GOOGLE_APPLICATION_CREDENTIALS=<YOUR_VALUE_HERE>

# ---------- Vertex AI ----------
PROJECT_ID=<YOUR_VALUE_HERE>
VERTEX_LOCATION="us-central1"
VERTEX_MODEL="gemini-2.5-pro"
VERTEX_TEMPERATURE="0.0"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIM="768"
